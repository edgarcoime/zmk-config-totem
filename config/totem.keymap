//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define TVP1 4
#define TVP2 5

/ {
    combos {
        compatible = "zmk,combos";

        combo_enter {
            bindings = <&kp ENTER>;
            key-positions = <27 28>;
        };

        combo_delete {
            bindings = <&kp DELETE>;
            key-positions = <24 23>;
        };

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <1 0>;
        };

        combo_tilde {
            bindings = <&kp TILDE>;
            key-positions = <0 20>;
            layers = <0>;
        };

        combo_minus {
            bindings = <&kp MINUS>;
            key-positions = <30 29>;
            layers = <0>;
        };

        combo_semi {
            bindings = <&kp SEMICOLON>;
            key-positions = <9 8>;
            layers = <0>;
        };

        combo_bslsh {
            bindings = <&kp BACKSLASH>;
            key-positions = <31 9>;
            layers = <0>;
        };
    };

    behaviors {
        layer_hold: layer_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_HOLD";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <100>;
            hold-while-undecided;
            retro-tap;
        };

        sticky_capsword: sticky_capsword {
            compatible = "zmk,behavior-tap-dance";
            label = "STICKY_CAPSWORD";
            #binding-cells = <0>;
            bindings = <&modified_sticky_shift LEFT_SHIFT>, <&caps_word>;

            tapping-term-ms = <150>;
        };

        super_shift: super_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "SUPER_SHIFT";
            bindings = <&kp>, <&sticky_capsword>;

            #binding-cells = <2>;
            tapping-term-ms = <500>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            hold-while-undecided-linger;
            retro-tap;
        };

        super_symbols: super_symbols {
            compatible = "zmk,behavior-hold-tap";
            label = "SUPER_SYMBOLS";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <100>;
            hold-while-undecided;
            retro-tap;
        };

        super_numbers: super_numbers {
            compatible = "zmk,behavior-hold-tap";
            label = "SUPER_NUMBERS";
            bindings = <&mo>, <&sl>;

            #binding-cells = <2>;
            tapping-term-ms = <100>;
            hold-while-undecided;
            retro-tap;
        };

        homerow: homerow {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };

        modified_sticky_shift: modified_sticky_shift {
            compatible = "zmk,behavior-sticky-key";
            label = "MODIFIED_STICKY_SHIFT";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <300>;
            quick-release;
        };

        sticky_mods: sticky_mods {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_MODS";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
            ignore-modifiers;
            lazy;
        };

        super_sticky_mods: super_sticky_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "SUPER_STICKY_MODS";
            bindings = <&kp>, <&sticky_mods>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            hold-while-undecided;
            retro-tap;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "BASE";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     Q     ┃     W     ┃     F     ┃     P     ┃     G     ┃   ┃     J     ┃     L     ┃     U     ┃     Y     ┃     ;     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃     A     ┃     R     ┃     S     ┃     T     ┃     D     ┃   ┃     H     ┃     N     ┃     E     ┃     I     ┃     O     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃     Q     ┃     Z     ┃     X     ┃     C     ┃     V     ┃     B     ┃   ┃     K     ┃     M     ┃     ,     ┃     .     ┃     /     ┃     \     ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃    DEL    ┃    TAB    ┃    SPC    ┃   ┃   ENTER   ┃           ┃   BSPC    ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
                         &kp B                &kp L                &kp D                    &kp W                  &kp Z            &kp SQT    &kp F                      &kp O                     &kp U                 &kp J
                         &homerow LEFT_GUI N  &homerow LEFT_ALT R  &homerow LEFT_CONTROL T  &homerow LEFT_SHIFT S  &kp G            &kp Y      &homerow RIGHT_SHIFT H     &homerow RIGHT_CONTROL A  &homerow RIGHT_ALT E  &homerow RIGHT_GUI I
&mt LEFT_CONTROL ESCAPE  &kp Q                &kp X                &kp M                    &kp C                  &kp V            &kp K      &kp P                      &kp DOT                   &kp MINUS             &kp FSLH              &kp COMMA
                                                                   &super_numbers 2 2       &super_symbols 1 1     &kp BACKSPACE    &kp SPACE  &super_shift LEFT_SHIFT 0  &layer_hold 3 UNDERSCORE
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        symbols {
            bindings = <
               &kp TILDE      &kp GRAVE       &kp PERCENT        &kp QUESTION  &kp SEMICOLON    &kp EXCLAMATION  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE
               &kp AMPERSAND  &kp APOSTROPHE  &kp DOUBLE_QUOTES  &kp COLON     &kp COMMA        &kp HASH         &kp CARET       &kp UNDERSCORE        &kp EQUAL              &kp DOLLAR
&kp BACKSLASH  &kp SLASH      &kp MINUS       &kp PLUS           &kp PERIOD    &kp AT           &kp PIPE         &kp LESS_THAN   &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp GREATER_THAN  &kp ASTERISK
                                              &trans             &to 2         &trans           &kp SPACE        &to 0           &trans
            >;
        };

        numbers {
            bindings = <
          &super_sticky_mods LEFT_GUI LEFT_GUI                                &super_sticky_mods LEFT_ALT LEFT_ALT  &super_sticky_mods LEFT_CONTROL LEFT_CONTROL  &super_sticky_mods LEFT_SHIFT LEFT_SHIFT  &kp SEMI      &kp MINUS  &kp N7  &kp N8          &kp N9  &kp PLUS
          &super_sticky_mods RA(RC(RG(RIGHT_SHIFT))) RA(RC(RG(RIGHT_SHIFT)))  &trans                                &trans                                        &trans                                    &kp COMMA     &kp N0     &kp N4  &kp N5          &kp N6  &kp ASTERISK
&kp CAPS  &trans                                                              &trans                                &trans                                        &trans                                    &kp PERIOD    &kp DOT    &kp N1  &kp N2          &kp N3  &kp SLASH     &kp EQUAL
                                                                                                                    &trans                                        &to 3                                     &trans        &kp N0     &to 0   &kp KP_NUMLOCK
            >;
        };

        functions {
            bindings = <
       &kp F12  &kp F7  &kp F8  &kp F9  &kp LGUI     &trans  &trans          &trans          &trans        &trans
       &kp F11  &kp F4  &kp F5  &kp F6  &kp LALT     &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW
&to 4  &kp F10  &kp F1  &kp F2  &kp F3  &kp LCTRL    &trans  &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &trans
                        &trans  &trans  &kp LSHFT    &trans  &to 0           &trans
            >;
        };

        adjust {
            bindings = <
        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &trans      &trans  &trans  &trans  &trans
        &trans        &trans        &trans        &trans        &trans            &trans      &trans  &trans  &trans  &trans
&trans  &bt BT_CLR    &trans        &trans        &trans        &bt BT_CLR_ALL    &trans      &trans  &trans  &trans  &trans  &trans
                                    &trans        &trans        &trans            &kp C_MUTE  &to 0   &trans
            >;
        };
    };
};
